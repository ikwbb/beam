{
  "name": "beam-visual-transfer",
  "version": "3.0.0",
  "private": true,
  "description": "Browser-only optical file transfer with loss recovery and integrity verification",
  "type": "module",
  "scripts": {
    "build:standalone": "node build-standalone.mjs",
    "test": "node --test",
