    "benchmark:codec": "node tests/raptorq-benchmark.mjs",
    "test:large": "node --expose-gc tests/raptorq-large.mjs",
    "test:browser": "node tests/browser-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
